# Build the Flatpak bundle (packaging/flatpak/README.md). No game data is on the runner: the app's build-time checks
# compile the project's own runtime and the toolchain only, and the game itself is built on the player's PC from their dump.
name: Flatpak

on:
  push:
    paths:
      - 'packaging/flatpak/**'
      - 'scripts/linux/**'
      - 'scripts/setup.py'
      - 'scripts/run.py'
      - 'requirements.txt'
      - 'tests/test_install_linux.py'
      - '.github/workflows/flatpak.yml'
  pull_request:
    paths:
      - 'packaging/flatpak/**'
      - 'scripts/linux/**'
      - 'scripts/setup.py'
      - 'scripts/run.py'
      - 'requirements.txt'
      - 'tests/test_install_linux.py'
      - '.github/workflows/flatpak.yml'
  workflow_dispatch:

jobs:
  flatpak:
    runs-on: ubuntu-24.04
    timeout-minutes: 90
    steps:
      - uses: actions/checkout@v4

      - name: Game-free driver checks
        run: python3 tests/test_install_linux.py

      - name: Install flatpak-builder and the freedesktop SDK
        run: |
          sudo apt-get update -qq
          sudo apt-get install -y -qq flatpak flatpak-builder xvfb
          flatpak remote-add --user --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo
          flatpak install --user -y flathub org.freedesktop.Sdk//25.08 org.freedesktop.Sdk.Extension.llvm20//25.08

      - name: Build the app
        run: |
          flatpak-builder --user --install --force-clean build-flatpak \
            packaging/flatpak/io.github.Rsoto95.OpenSmashUltimate.yml

      - name: Smoke test the launcher in the sandbox
        run: |
          xvfb-run -a flatpak run --user --socket=x11 io.github.Rsoto95.OpenSmashUltimate --self-test

      - name: Bundle
        run: |
          flatpak build-bundle ~/.local/share/flatpak/repo OpenSmashUltimate.flatpak \
            io.github.Rsoto95.OpenSmashUltimate

      - uses: actions/upload-artifact@v4
        with:
          name: OpenSmashUltimate-flatpak
          path: OpenSmashUltimate.flatpak
          if-no-files-found: error
